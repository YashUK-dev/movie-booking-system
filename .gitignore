# Root-level gitignore for the movie-booking-system monorepo

# ─── Node.js / npm ────────────────────────────────────────────────────────
node_modules/
jspm_packages/

# ─── Environment & Secrets ────────────────────────────────────────────────
# NEVER commit .env files — they contain real credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ─── Build outputs ────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/

# ─── Logs ─────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Runtime / OS ─────────────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock
.DS_Store
Thumbs.db

# ─── Testing & Coverage ───────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── IDE / Editor ─────────────────────────────────────────────────────────
.vscode/
.idea/

# ─── Cache / Misc ─────────────────────────────────────────────────────────
.npm
.eslintcache
.stylelintcache
.parcel-cache
.cache/
.tsbuildinfo
