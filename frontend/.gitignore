# Frontend .gitignore

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/

# Environment variables (teammates: copy .env.example → .env, fill in values)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Coverage
coverage/

# Vite cache
.vite/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Ignore large media files
public/videos/*.mp4